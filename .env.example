# Copy this file to .env and fill in the values
# Never commit the actual .env file

# ── PostgreSQL ──────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=olist_db
POSTGRES_USER=olist_user
POSTGRES_PASSWORD=

# ── Elasticsearch ───────────────────────────
ES_HOST=elasticsearch
ES_PORT=9200
ES_INDEX_ORDERS=olist_orders
ES_INDEX_PRODUCTS=olist_products
ES_INDEX_SELLERS=olist_sellers

# ── Airflow ─────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://olist_user:YOURPASSWORD@postgres:5432/olist_db
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=

# ── ETL ─────────────────────────────────────
DATA_PATH=/opt/airflow/data
BATCH_SIZE=1000
